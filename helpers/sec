#!/usr/bin/env bash
# sec - read and write secrets in the keyring (Secret Service, KWallet).
# Each secret has the attributes: service claude-helper, key NAME.
# The tool never takes a secret value as an argument. Use stdin.

set -u
SERVICE="claude-helper"

usage() {
  cat <<'USAGE'
Usage:
  sec get NAME                 Print the value. No trailing newline. Exit 1 if missing.
  sec set NAME                 Read the value from stdin. Store it in the keyring.
  sec list                     Print the names only.
  sec del NAME                 Delete the secret.
  sec run VAR=NAME ... -- CMD  Run CMD with the secrets in its environment only.

Example:
  printf '%s' "$TOKEN" | sec set my-token
  curl -H "Authorization: Bearer $(sec get my-token)" https://example.com
  sec run API_KEY=my-token -- ./deploy.sh
USAGE
}

die() {
  printf 'sec: %s\n' "$*" >&2
  exit 1
}

check_name() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || die "bad name: use letters, digits, dot, underscore, or hyphen"
}

# macOS uses the login Keychain: account NAME, service claude-helper.
if [[ "$(uname -s)" == Darwin ]]; then
  # The Keychain item holds the hex text of the value. "-w" prints binary or
  # multi-line data as hex, so a plain value would be ambiguous on read.
  kr_lookup() {
    local hex
    hex=$(security find-generic-password -s "$SERVICE" -a "$1" -w 2>/dev/null) || return 1
    printf '%s' "$hex" | xxd -r -p
  }
  # The value goes in on the stdin of "security -i", never in argv.
  kr_store() {
    local hex
    hex=$(xxd -p | tr -d '\n')
    if ((${#hex} < 3500)); then
      printf 'add-generic-password -U -s %s -a %s -l "%s %s" -w %s\n' "$SERVICE" "$1" "$SERVICE" "$1" "$hex" |
        security -i >/dev/null 2>&1
    else
      # shortcut: "security -i" refuses long lines, so a large value (a key file) goes in argv for a moment; use the Security framework if that matters.
      security add-generic-password -U -s "$SERVICE" -a "$1" -l "$SERVICE $1" -w "$hex" >/dev/null 2>&1
    fi
  }
  kr_list() {
    # In each item of the dump, "acct" comes before "svce".
    security dump-keychain 2>/dev/null |
      awk -v s="\"$SERVICE\"" '
        /^keychain:/ { a = "" }
        /"acct"<blob>=/ { a = $0; sub(/.*"acct"<blob>=/, "", a) }
        /"svce"<blob>=/ { v = $0; sub(/.*"svce"<blob>=/, "", v); if (v == s && a != "") print a }' |
      tr -d '"' | sort -u
  }
  kr_clear() { security delete-generic-password -s "$SERVICE" -a "$1" >/dev/null; }
else
  kr_lookup() { secret-tool lookup service "$SERVICE" key "$1" 2>/dev/null; }
  kr_store() { secret-tool store --label="$SERVICE $1" service "$SERVICE" key "$1"; }
  kr_list() { secret-tool search --all service "$SERVICE" 2>&1 | sed -n 's/^attribute\.key = //p' | sort -u; }
  kr_clear() { secret-tool clear service "$SERVICE" key "$1"; }
fi

cmd_get() {
  check_name "${1:-}"
  kr_lookup "$1" || exit 1
}

cmd_set() {
  check_name "${1:-}"
  local value
  value=$(cat)
  [[ -n "$value" ]] || die "the value on stdin is empty"
  printf '%s' "$value" | kr_store "$1" || die "the keyring refused the value"
}

cmd_list() {
  kr_list
}

cmd_del() {
  check_name "${1:-}"
  kr_clear "$1"
}

cmd_run() {
  local -a names=() vars=()
  local pair
  while [[ $# -gt 0 && "$1" != "--" ]]; do
    pair="$1"
    [[ "$pair" == *=* ]] || die "bad pair '$pair': use VAR=NAME"
    [[ "${pair%%=*}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad variable name in '$pair'"
    check_name "${pair#*=}"
    vars+=("${pair%%=*}")
    names+=("${pair#*=}")
    shift
  done
  [[ "${1:-}" == "--" ]] || die "missing '--' before the command"
  shift
  [[ $# -gt 0 ]] || die "missing command"
  local i value
  for i in "${!vars[@]}"; do
    value=$(kr_lookup "${names[$i]}") ||
      die "secret not found: ${names[$i]}"
    export "${vars[$i]}=$value"
  done
  exec "$@"
}

sub="${1:-}"
[[ $# -gt 0 ]] && shift
case "$sub" in
  get) cmd_get "$@" ;;
  set) cmd_set "$@" ;;
  list) cmd_list ;;
  del) cmd_del "$@" ;;
  run) cmd_run "$@" ;;
  -h | --help | help | "") usage ;;
  *) usage >&2; exit 2 ;;
esac
