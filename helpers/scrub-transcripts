#!/usr/bin/env python3
"""Remove secrets from Claude transcripts and replace them with {sec:NAME}.

The default mode is a dry run. It prints counts by kind. It never prints values.
With --apply, the tool stores each secret in the keyring first.
Then the tool rewrites the file in place.
"""
import argparse
import importlib.util
import json
import os
import subprocess
import sys
import tempfile
import time
from collections import Counter

HERE = os.path.dirname(os.path.abspath(__file__))
REAL_ROOT = os.path.expanduser("~/.claude")
EXTENSIONS = (".jsonl", ".json", ".txt", ".log")
RECENT_SECONDS = 30 * 60


def load_lib():
    spec = importlib.util.spec_from_file_location(
        "secret_lib", os.path.join(HERE, "secret-lib.py")
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


lib = load_lib()


def is_protected(path):
    """Return True for a file that the tool must never touch."""
    # A symlink points into a repository (loadout links skills and helpers): never rewrite it.
    if os.path.islink(path):
        return True
    real = os.path.realpath(path)
    helpers = os.path.realpath(os.path.join(REAL_ROOT, "helpers")) + os.sep
    if real.startswith(helpers):
        return True
    base = os.path.basename(real)
    if base == ".claude.json" or base.startswith("settings"):
        return True
    return False


def running_session_ids(roots):
    """Return the session ids of running claude processes."""
    ids = set()
    try:
        out = subprocess.run(["pgrep", "-x", "claude"], capture_output=True, text=True)
        pids = set(out.stdout.split())
    except Exception:
        return ids
    for pid in pids:
        try:
            for fd in os.listdir("/proc/%s/fd" % pid):
                try:
                    target = os.readlink("/proc/%s/fd/%s" % (pid, fd))
                except OSError:
                    continue
                base = os.path.basename(target)
                if base.endswith(".jsonl") and "/projects/" in target:
                    ids.add(base[:-6])
                parent = os.path.basename(os.path.dirname(target))
                if "/projects/" in target and len(parent) == 36:
                    ids.add(parent)
        except OSError:
            pass
        for root in roots:
            try:
                with open(os.path.join(root, "sessions", pid + ".json")) as f:
                    sid = json.load(f).get("sessionId")
                if sid:
                    ids.add(sid)
            except Exception:
                pass
    return ids


def session_id_of(path, ids):
    """Return the running session id that owns the path, or None."""
    parts = os.path.normpath(path).split(os.sep)
    for p in parts:
        if p.endswith(".jsonl") and p[:-6] in ids:
            return p[:-6]
        if p in ids:
            return p
    return None


def walk_files(paths):
    for top in paths:
        if os.path.isfile(top):
            yield top
            continue
        for dirpath, _dirs, files in os.walk(top):
            for fn in files:
                if fn.endswith(EXTENSIONS):
                    yield os.path.join(dirpath, fn)


def check_valid(path, old, new):
    """Return True if the new text is as valid JSON as the old text."""
    if path.endswith(".jsonl"):
        ol, nl = old.split("\n"), new.split("\n")
        if len(ol) != len(nl):
            return False
        for a, b in zip(ol, nl):
            if a == b or not a.strip():
                continue
            try:
                json.loads(a)
            except ValueError:
                continue
            try:
                json.loads(b)
            except ValueError:
                return False
        return True
    if path.endswith(".json"):
        try:
            json.loads(old)
        except ValueError:
            return True
        try:
            json.loads(new)
        except ValueError:
            return False
    return True


def process(path, apply, min_count):
    """Scan one file. Return a Counter by kind, or None if skipped."""
    try:
        st = os.stat(path)
        with open(path, "rb") as f:
            raw = f.read()
    except OSError:
        return None
    text = raw.decode("utf-8", "surrogateescape")
    found = lib.find_secrets(text)
    if len(found) < min_count or not found:
        return Counter()
    counts = Counter(f[0] for f in found)
    if not apply:
        return counts
    names = {}
    try:
        for kind, value, _s, _e in found:
            if (kind, value) not in names:
                names[(kind, value)] = lib.store(kind, value)
    except Exception as exc:
        print("error: keyring store failed, skip %s (%s)" % (path, exc), file=sys.stderr)
        return None
    new_text = lib.apply_redactions(text, found, names)
    if not check_valid(path, text, new_text):
        print("error: JSON check failed, original kept: %s" % path, file=sys.stderr)
        return None
    st2 = os.stat(path)
    if (st2.st_mtime_ns, st2.st_size) != (st.st_mtime_ns, st.st_size):
        print("skip: file changed while scanning: %s" % path, file=sys.stderr)
        return None
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".scrub-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(new_text.encode("utf-8", "surrogateescape"))
        os.chmod(tmp, st.st_mode & 0o7777)
        os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
        os.replace(tmp, path)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    return counts


def main():
    ap = argparse.ArgumentParser(
        description="Find secrets in Claude transcripts. Default is a dry run."
    )
    ap.add_argument("--apply", action="store_true",
                    help="Store the secrets in the keyring. Then rewrite the files.")
    ap.add_argument("--root", default=REAL_ROOT,
                    help="Claude data folder. Default: %(default)s")
    ap.add_argument("--include-recent", action="store_true",
                    help="Also scan files changed in the last 30 minutes.")
    ap.add_argument("--transcript", metavar="PATH",
                    help="Scan one transcript and its session folder only.")
    ap.add_argument("--min-count", type=int, default=1,
                    help="Touch only a file with at least this many matches.")
    args = ap.parse_args()

    root = os.path.abspath(args.root)
    if args.transcript:
        t = os.path.abspath(args.transcript)
        paths = [t]
        if t.endswith(".jsonl"):
            paths.append(t[:-6])
        paths = [p for p in paths if os.path.exists(p)]
        ignore_rules = True
    else:
        paths = [os.path.join(root, "projects"),
                 os.path.join(root, "history.jsonl"),
                 os.path.join(root, "paste-cache")]
        paths = [p for p in paths if os.path.exists(p)]
        ignore_rules = args.include_recent

    ids = set()
    # A custom root holds copies. Running sessions do not write there.
    if not args.transcript and root == os.path.realpath(REAL_ROOT):
        ids = running_session_ids({root})

    totals = Counter()
    files_hit = 0
    files_seen = 0
    skipped_recent = 0
    skipped_running = 0
    unique = set()
    now = time.time()
    for path in walk_files(paths):
        if os.path.islink(path) or is_protected(path):
            continue
        if not path.endswith(EXTENSIONS):
            continue
        try:
            mtime = os.stat(path).st_mtime
        except OSError:
            continue
        if not args.transcript:
            if session_id_of(path, ids):
                skipped_running += 1
                continue
            if not ignore_rules and now - mtime < RECENT_SECONDS:
                skipped_recent += 1
                continue
        files_seen += 1
        counts = process(path, args.apply, args.min_count)
        if counts:
            files_hit += 1
            totals.update(counts)
            detail = ", ".join("%s=%d" % kv for kv in sorted(counts.items()))
            print("%s: %s" % (path, detail))
    mode = "APPLY" if args.apply else "DRY RUN"
    print("--- %s ---" % mode)
    print("files scanned: %d" % files_seen)
    print("files with matches: %d" % files_hit)
    print("skipped (recent): %d, skipped (running session): %d"
          % (skipped_recent, skipped_running))
    for kind, n in sorted(totals.items()):
        print("total %s: %d" % (kind, n))
    print("total matches: %d" % sum(totals.values()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
